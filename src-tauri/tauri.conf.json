{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-desktop",
  "version": "0.1.0",
  "identifier": "com.dsh-desktop.app",
  "build": {
    "beforeDevCommand": "/Users/acfufu/Codehub/dsh-desktop/scripts/dev-frontend.sh",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": [
      "resources/dsh.tar.gz"
    ],
    "icon": [
      "icons/icon.icns"
    ]
  }
}
